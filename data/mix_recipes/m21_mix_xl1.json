      "min_tokens": 16384,
      "max_tokens": 131072,
      "round_chars": 12000000000.0,
      "val_min_rows": {
        "16384": 32,
        "65536": 8
      },
      "note": "Raw files that code_files does not read. The rows of a repository are scattered over a language's raw files, so each part gathers repositories within rounds of round_chars characters (about four raw files; a larger round gathers more of each repository and needs as much temporary disk). Rust has one raw file only (read by code_files), so there are no Rust packs.",
      "parts": [
        {
          "label": "Python",
          "share": 0.3,
