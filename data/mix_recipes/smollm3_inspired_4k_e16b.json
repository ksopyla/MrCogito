{
  "mix_id": "smollm3_inspired_4k_e16b",
  "description": "E16b long-context mix for Gemma seq=4096: upweight coherent long documents (FinePDFs, DCLM) while keeping web/code/math/reasoning breadth. Designed so multi-block recurrent concept memory sees genuine beyond-2K structure.",
  "objective_compatibility": [
    "causal_lm",
    "reconstruction",
    "prefix_suffix"
  ],
  "seq_len_target": 4096,
  "long_context_policy": {
    "target_min_pct_docs_over_2k": 35.0,
    "target_min_pct_docs_over_4k": 18.0,
    "notes": "FinePDFs + DCLM carry the long tail; FineWeb/Stack keep fluency; math/reasoning keep structured multi-step text."
  },
  "sources": [
    {
      "name": "finepdfs_100BT",
      "hf_id": "HuggingFaceFW/finepdfs_100BT",
      "subset": "default",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.28,
      "max_shards": 16,
      "max_samples": 2500000,
      "file_glob": "data/*.parquet",
      "notes": "Primary long coherent document backbone for 4K."
    },
    {
      "name": "dclm_baseline",
      "hf_id": "mlfoundations/dclm-baseline-1.0",
      "subset": "default",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.22,
      "max_shards": 50,
      "max_samples": 2000000,
      "file_suffix": ".jsonl.zst",
      "recursive": true,
      "file_glob": "global-shard_01_of_10/*",
      "notes": "High-quality web with a useful long tail; recursive .jsonl.zst listing."
    },
    {
      "name": "fineweb_edu",
      "hf_id": "HuggingFaceFW/fineweb-edu",
      "subset": "sample-10BT",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.18,
      "max_shards": 8,
      "max_samples": 2000000,
      "file_glob": "sample/10BT/*.parquet"
    },
    {
      "name": "stack_edu_py_js",
      "hf_id": "meryyllebr543/stack-edu-huggingface",
      "subset": "python",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.12,
      "max_samples": 1000000,
      "file_globs": ["python.parquet", "javascript.parquet", "typescript.parquet", "markdown.parquet"],
      "notes": "Long files help multi-block carry; same language subset as E05."
    },
    {
      "name": "finemath_3plus",
      "hf_id": "HuggingFaceTB/finemath",
      "subset": "finemath-3plus",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.10,
      "max_shards": 12,
      "max_samples": 1200000
    },
    {
      "name": "big_reasoning_traces",
      "hf_id": "allenai/big-reasoning-traces",
      "subset": "DeepSeek",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.05,
      "max_shards": 10,
      "max_samples": 500000
    },
    {
      "name": "openmathreasoning_cot",
      "hf_id": "nvidia/OpenMathReasoning",
      "subset": "default",
      "split": "cot",
      "text_columns": ["problem", "generated_solution"],
      "weight": 0.05,
      "max_shards": 8,
      "max_samples": 400000,
      "file_glob": "data/cot-*.parquet"
    }
  ]
}
