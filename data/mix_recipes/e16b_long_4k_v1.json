{
  "mix_id": "e16b_long_4k_v1",
  "description": "E16b bold long-document mix at seq=4096: FinePDFs + PG19 books + Wikipedia for coherent multi-block documents, with DCLM/FineWeb/Stack for fluency. Scout-aligned; peS2o/Nemotron/ProLong deferred (json.gz / gated / MDS).",
  "objective_compatibility": [
    "causal_lm",
    "reconstruction",
    "prefix_suffix"
  ],
  "seq_len_target": 4096,
  "long_context_policy": {
    "target_min_pct_docs_over_2k": 40.0,
    "target_min_pct_docs_over_4k": 20.0,
    "notes": "Long tier = FinePDFs + PG19; Wikipedia medium; web/code for fluency. No cross-doc packing."
  },
  "sources": [
    {
      "name": "finepdfs_100BT",
      "hf_id": "HuggingFaceFW/finepdfs_100BT",
      "subset": "default",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.30,
      "max_shards": 16,
      "max_samples": 2500000,
      "file_glob": "data/*.parquet",
      "notes": "Primary long coherent PDF backbone (catalog ~20% >4k); E05-proven pretok path."
    },
    {
      "name": "pg19",
      "hf_id": "emozilla/pg19",
      "subset": "default",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.18,
      "max_shards": 23,
      "max_samples": 50000,
      "file_glob": "data/train-*.parquet",
      "notes": "Book-length narrative coherence; ~28k books across 23 train shards."
    },
    {
      "name": "dclm_baseline",
      "hf_id": "mlfoundations/dclm-baseline-1.0",
      "subset": "default",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.15,
      "max_shards": 40,
      "max_samples": 1500000,
      "file_suffix": ".jsonl.zst",
      "recursive": true,
      "file_glob": "global-shard_01_of_10/*"
    },
    {
      "name": "wikipedia_en",
      "hf_id": "wikimedia/wikipedia",
      "subset": "default",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.12,
      "max_shards": 41,
      "max_samples": 2000000,
      "file_glob": "20231101.en/train-*.parquet",
      "notes": "Entity-dense structured prose; CC-BY-SA attribution."
    },
    {
      "name": "fineweb_edu",
      "hf_id": "HuggingFaceFW/fineweb-edu",
      "subset": "sample-10BT",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.10,
      "max_shards": 8,
      "max_samples": 1500000,
      "file_glob": "sample/10BT/*.parquet"
    },
    {
      "name": "stack_edu_py_js",
      "hf_id": "meryyllebr543/stack-edu-huggingface",
      "subset": "python",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.10,
      "max_samples": 1000000,
      "file_globs": ["python.parquet", "javascript.parquet", "typescript.parquet", "markdown.parquet"]
    },
    {
      "name": "finemath_3plus",
      "hf_id": "HuggingFaceTB/finemath",
      "subset": "finemath-3plus",
      "split": "train",
      "text_columns": ["text"],
      "weight": 0.05,
      "max_shards": 10,
      "max_samples": 800000
    }
  ]
}
