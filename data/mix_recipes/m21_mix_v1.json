{
 "name": "m21mix_v1",
 "description": "E38 pretraining mix, SmolLM2 tokenizer. Built by scripts/build_m21_mix.py (on a node: infra/aws/jobs/m21_data_build.sh). target_tokens = TRAIN tokens to build per source; a phase's weights are shares of that phase's tokens. fineweb_edu and dclm_edu serve the trunk and the later phases: their targets cover the sum, and the manifest writer gives later phases the last shards (shard token counts are in each done.json). Every Hub source was checked public and ungated without a token on 2026-11-14.",
 "tokenizer": "HuggingFaceTB/SmolLM2-135M",
 "vocab_size": 49152,
 "eot": 0,
 "shard_tokens": 100000000,
 "defaults": {
  "val_fraction": 0.005,
  "val_tokens": 2000000,
  "val_min_docs": 40,
  "min_chars_per_token": 2.0
 },
