# Copy to `.env` and fill in real values. Never commit `.env`.
# Loaded by python-dotenv via training/evaluation scripts.

# --- Hugging Face -----------------------------------------------------------
# Token from https://huggingface.co/settings/tokens (read or write as needed).
HF_TOKEN=
# Local HF cache. Use an ABSOLUTE path (relative paths break when scripts are run
# from a non-repo-root CWD). On the GPU servers this line is overridden by
# scripts/remote_paths.sh which exports HF_HOME=/home/ksopyla/dev/hf_home.
# The HF_HOME tree has three role-specific subdirs (see remote-servers SKILL.md):
#   datasets/      raw load_dataset() cache       (HF_DATASETS_CACHE)
#   datasets_tok/  pre-tokenized corpora          (DATASETS_TOK_DIR)
#   datasets_raw/  transient raw parquet/zst      (DATASETS_RAW_DIR)
HF_HOME=/absolute/path/to/MrCogito/Cache/hf_home
# Faster downloads (requires `hf-transfer`, which is already in pyproject).
HF_HUB_ENABLE_HF_TRANSFER=1

# --- Weights & Biases -------------------------------------------------------
# Token from https://wandb.ai/authorize
# Used by training scripts and the W&B MCP server (.cursor/scripts/wandb-mcp.sh).
# The MCP bridge uses W&B's hosted endpoint (mcp.withwandb.com) via mcp-remote.
WANDB_API_KEY=
WANDB_PROJECT=MrCogito
WANDB_ENTITY=ksopyla

# --- PyTorch / MPS (macOS) --------------------------------------------------
# Allow PyTorch to fall back to CPU for ops not yet implemented on MPS.
PYTORCH_ENABLE_MPS_FALLBACK=1
