{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcogito.local/nn-builder/graph.schema.json",
  "title": "nn-builder graph, version 1",
  "description": "A network composed of stacks of rows of cells, wires between them, and loop/repeat groups. Semantics: docs/schema.md.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "name",
    "description",
    "stacks",
    "edges",
    "groups",
    "run"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nn-builder/graph"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "stacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stack"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "ui": {
      "type": "object",
      "description": "Layout only; never changes the model."
    },
    "derived": {
      "type": "object",
      "description": "Written on export: the estimates at export time (parameter counts per cell, widths). Informational; a code generator can check its model against it."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "pos": {
      "type": "integer",
      "minimum": 1
    },
    "norm": {
      "enum": [
        "rmsnorm",
        "layernorm",
        "none"
      ]
    },
    "residual": {
      "enum": [
        "pre",
        "post",
        "none"
      ]
    },
    "seq": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tokens"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "length"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source"
            },
            "length": {
              "$ref": "#/$defs/count"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "of",
            "window",
            "stride"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pages"
            },
            "of": {
              "$ref": "#/$defs/id"
            },
            "window": {
              "$ref": "#/$defs/pos"
            },
            "stride": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "of",
            "per_page"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "slots"
            },
            "of": {
              "$ref": "#/$defs/id"
            },
            "per_page": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "latents"
            },
            "count": {
              "$ref": "#/$defs/pos"
            }
          }
        }
      ]
    },
    "stack": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "width",
        "seq",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "decoder",
            "encoder",
            "writer",
            "latent",
            "other"
          ]
        },
        "width": {
          "$ref": "#/$defs/pos"
        },
        "seq": {
          "$ref": "#/$defs/seq"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "x0_mix",
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "x0_mix": {
          "type": "boolean"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/embedding"
        },
        {
          "$ref": "#/$defs/positional"
        },
        {
          "$ref": "#/$defs/attention"
        },
        {
          "$ref": "#/$defs/ffn"
        },
        {
          "$ref": "#/$defs/normCell"
        },
        {
          "$ref": "#/$defs/linear"
        },
        {
          "$ref": "#/$defs/latent_init"
        },
        {
          "$ref": "#/$defs/kv_out"
        },
        {
          "$ref": "#/$defs/lm_head"
        },
        {
          "$ref": "#/$defs/custom"
        }
      ]
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "vocab",
        "dim",
        "ngram_tables",
        "ngram_buckets",
        "proj",
        "out_norm"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "embedding"
        },
        "vocab": {
          "$ref": "#/$defs/pos"
        },
        "dim": {
          "$ref": "#/$defs/pos"
        },
        "ngram_tables": {
          "$ref": "#/$defs/count"
        },
        "ngram_buckets": {
          "$ref": "#/$defs/count"
        },
        "proj": {
          "enum": [
            "none",
            "linear",
            "gated_mlp"
          ]
        },
        "out_norm": {
          "$ref": "#/$defs/norm"
        },
        "share_with": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "positional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "kind",
        "theta",
        "max_len"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "positional"
        },
        "kind": {
          "enum": [
            "rope",
            "learned",
            "sinusoidal",
            "alibi",
            "none"
          ]
        },
        "theta": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_len": {
          "$ref": "#/$defs/pos"
        }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "mode",
        "heads",
        "head_dim",
        "kv_heads",
        "causal",
        "window",
        "qk_norm",
        "bias",
        "norm",
        "kv_norm",
        "residual",
        "memory",
        "dual_key",
        "nope",
        "kernel",
        "extras"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "attention"
        },
        "mode": {
          "enum": [
            "self",
            "cross"
          ]
        },
        "heads": {
          "$ref": "#/$defs/pos"
        },
        "head_dim": {
          "$ref": "#/$defs/pos"
        },
        "kv_heads": {
          "$ref": "#/$defs/pos"
        },
        "causal": {
          "type": "boolean"
        },
        "window": {
          "$ref": "#/$defs/count"
        },
        "qk_norm": {
          "type": "boolean"
        },
        "bias": {
          "type": "boolean"
        },
        "norm": {
          "$ref": "#/$defs/norm"
        },
        "kv_norm": {
          "$ref": "#/$defs/norm"
        },
        "residual": {
          "$ref": "#/$defs/residual"
        },
        "memory": {
          "type": "boolean"
        },
        "dual_key": {
          "type": "boolean"
        },
        "nope": {
          "type": "boolean"
        },
        "kernel": {
          "enum": [
            "flash",
            "eager"
          ]
        },
        "extras": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order_term",
            "count_heads",
            "count_max",
            "pos_prior",
            "logit_scale"
          ],
          "properties": {
            "order_term": {
              "type": "boolean"
            },
            "count_heads": {
              "$ref": "#/$defs/count"
            },
            "count_max": {
              "$ref": "#/$defs/count"
            },
            "pos_prior": {
              "type": "boolean"
            },
            "logit_scale": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ffn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "kind",
        "hidden",
        "activation",
        "bias",
        "experts",
        "top_k",
        "norm",
        "residual"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "ffn"
        },
        "kind": {
          "enum": [
            "swiglu",
            "geglu",
            "mlp"
          ]
        },
        "hidden": {
          "$ref": "#/$defs/pos"
        },
        "activation": {
          "enum": [
            "gelu",
            "relu",
            "silu"
          ]
        },
        "bias": {
          "type": "boolean"
        },
        "experts": {
          "$ref": "#/$defs/pos"
        },
        "top_k": {
          "$ref": "#/$defs/pos"
        },
        "norm": {
          "$ref": "#/$defs/norm"
        },
        "residual": {
          "$ref": "#/$defs/residual"
        }
      }
    },
    "normCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "norm"
        },
        "kind": {
          "$ref": "#/$defs/norm"
        }
      }
    },
    "linear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "out",
        "bias",
        "out_norm"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "linear"
        },
        "out": {
          "$ref": "#/$defs/count"
        },
        "bias": {
          "type": "boolean"
        },
        "out_norm": {
          "$ref": "#/$defs/norm"
        }
      }
    },
    "latent_init": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "address_feats",
        "norm"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "latent_init"
        },
        "address_feats": {
          "$ref": "#/$defs/count"
        },
        "norm": {
          "$ref": "#/$defs/norm"
        }
      }
    },
    "kv_out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "entries",
        "kv_heads",
        "head_dim",
        "projections",
        "in_norms",
        "key_norm"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "kv_out"
        },
        "entries": {
          "$ref": "#/$defs/pos"
        },
        "kv_heads": {
          "$ref": "#/$defs/pos"
        },
        "head_dim": {
          "$ref": "#/$defs/pos"
        },
        "projections": {
          "enum": [
            2,
            4
          ]
        },
        "in_norms": {
          "$ref": "#/$defs/count"
        },
        "key_norm": {
          "type": "boolean"
        }
      }
    },
    "lm_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "vocab",
        "tied",
        "bias",
        "final_norm",
        "z_loss",
        "softcap",
        "chunked"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "lm_head"
        },
        "vocab": {
          "$ref": "#/$defs/pos"
        },
        "tied": {
          "type": "boolean"
        },
        "bias": {
          "type": "boolean"
        },
        "final_norm": {
          "$ref": "#/$defs/norm"
        },
        "z_loss": {
          "type": "number",
          "minimum": 0
        },
        "softcap": {
          "type": "number",
          "minimum": 0
        },
        "chunked": {
          "type": "boolean"
        }
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "params",
        "flops_per_position",
        "act_bytes_per_position",
        "out",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "custom"
        },
        "params": {
          "$ref": "#/$defs/count"
        },
        "flops_per_position": {
          "type": "number",
          "minimum": 0
        },
        "act_bytes_per_position": {
          "type": "number",
          "minimum": 0
        },
        "out": {
          "$ref": "#/$defs/count"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack"
      ],
      "properties": {
        "stack": {
          "$ref": "#/$defs/id"
        },
        "row": {
          "$ref": "#/$defs/id"
        },
        "cell": {
          "$ref": "#/$defs/id"
        },
        "port": {
          "enum": [
            "out",
            "table"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "skip",
            "source",
            "input"
          ]
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "weight": {
          "enum": [
            "scalar",
            "vector",
            "none"
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "skip"
          }
        }
      },
      "then": {
        "required": [
          "weight"
        ]
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "stack",
        "rows",
        "count",
        "round_embedding",
        "feedback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "loop",
            "repeat"
          ]
        },
        "stack": {
          "$ref": "#/$defs/id"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "count": {
          "$ref": "#/$defs/pos"
        },
        "round_embedding": {
          "type": "boolean"
        },
        "feedback": {
          "enum": [
            "none",
            "soft"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_length",
        "rows_per_step",
        "micro_batch",
        "precision",
        "optimizer",
        "weight_decay",
        "zero_stage",
        "checkpointing",
        "gpu",
        "gpu_count",
        "token_budget",
        "deadline_hours",
        "mfu",
        "irregular_ratio",
        "dp_efficiency"
      ],
      "properties": {
        "row_length": {
          "$ref": "#/$defs/pos"
        },
        "rows_per_step": {
          "$ref": "#/$defs/pos"
        },
        "micro_batch": {
          "$ref": "#/$defs/count"
        },
        "precision": {
          "enum": [
            "amp_bf16",
            "bf16_master",
            "pure_bf16",
            "fp32"
          ]
        },
        "optimizer": {
          "enum": [
            "adamw",
            "adamw_8bit",
            "sgd_momentum",
            "muon",
            "adafactor"
          ]
        },
        "weight_decay": {
          "type": "number",
          "minimum": 0
        },
        "zero_stage": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "checkpointing": {
          "type": "boolean"
        },
        "gpu": {
          "type": "string"
        },
        "gpu_count": {
          "$ref": "#/$defs/pos"
        },
        "token_budget": {
          "type": "number",
          "minimum": 0
        },
        "deadline_hours": {
          "type": "number",
          "minimum": 0
        },
        "mfu": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "irregular_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dp_efficiency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
